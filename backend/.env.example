# CodeVita AI Coach Backend Environment Configuration
PROJECT_NAME="CodeVita AI Coach"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database (Default: local SQLite; for PostgreSQL cloud production, use: postgresql+asyncpg://user:pass@host:port/dbname)
DATABASE_URL="sqlite+aiosqlite:///./codevita.db"

# JWT Security
SECRET_KEY="dev-secret-key-change-in-production-codevita-ai-coach-2026-supersecure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# NVIDIA Nemotron NIM API Configuration
# Get your API key from https://build.nvidia.com/
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# Code Execution Sandbox
EXECUTION_MODE="cloud"
JUDGE0_API_URL="https://ce.judge0.com"
WANDBOX_API_URL="https://wandbox.org/api/compile.json"
